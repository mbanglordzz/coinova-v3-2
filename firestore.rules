    }

    match /server_sessions/{sessionId} {
      allow get: if isValidDocId(sessionId);
      allow list: if isValidServerRealm(resource.data.serverRealm);
      allow create, update: if isValidDocId(sessionId) && isValidServerSession(request.resource.data);
      allow delete: if isAdmin();
    }

    match /server_diamond_challenges/{challengeId} {
      allow get: if isValidDocId(challengeId);
      allow list: if isValidServerRealm(resource.data.serverRealm);
      allow create, update: if isValidDocId(challengeId) && isValidServerDiamondChallenge(request.resource.data);
      allow delete: if isAdmin();
    }

    match /server_suspicious_taps/{eventId} {
      allow get: if isValidDocId(eventId);
      allow list: if isValidServerRealm(resource.data.serverRealm);
      allow create, update: if isValidDocId(eventId) && isValidServerSuspiciousTap(request.resource.data);
      allow delete: if isAdmin();
    }

    match /server_config/{docKey} {
      allow get: if isValidDocId(docKey);
      allow list: if isValidServerRealm(resource.data.serverRealm);
      allow create, update: if isValidDocId(docKey) && isValidServerConfigDoc(request.resource.data);
      allow delete: if isAdmin();
    }

    match /server_event_cooldowns/{docId} {
      allow get: if isValidDocId(docId);
      allow list: if isValidServerRealm(resource.data.serverRealm);
      allow create, update: if isValidDocId(docId) && isValidServerRealm(request.resource.data.serverRealm);
      allow delete: if isAdmin();
    }

    match /server_vip_orders/{orderId} {
      allow get: if isValidDocId(orderId);
      allow list: if isValidServerRealm(resource.data.serverRealm);
      allow create, update: if isValidDocId(orderId) && isValidServerRealm(request.resource.data.serverRealm);
      allow delete: if isAdmin();
    }

    match /server_broadcasts/{broadcastId} {
      allow get: if isValidDocId(broadcastId);
      allow list: if isValidServerRealm(resource.data.serverRealm);
      allow create, update: if isValidDocId(broadcastId) && isValidServerRealm(request.resource.data.serverRealm);
