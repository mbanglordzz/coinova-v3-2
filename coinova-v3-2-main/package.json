{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "NODE_ENV=production tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "cf:d1:create": "wrangler d1 create coinova-db",
    "cf:d1:migrate:local": "wrangler d1 execute coinova-db --local --file=./migrations/0001_coinova_d1_schema.sql",
    "cf:d1:migrate:remote": "wrangler d1 execute coinova-db --remote --file=./migrations/0001_coinova_d1_schema.sql",
    "cf:dev:pages": "vite build && wrangler pages dev dist --d1 DB=coinova-db",
    "cf:dev:worker": "wrangler dev -c wrangler.worker.toml",
    "cf:deploy:pages": "vite build && wrangler pages deploy dist --project-name coinova-app",
    "cf:deploy:worker": "wrangler deploy -c wrangler.worker.toml"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "hono": "^4.13.10",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260928.1",
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "eslint": "^10.11.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^1.3.0"
  }
}
