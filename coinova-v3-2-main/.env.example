# ============================================================================
# COINOVA ENVIRONMENT VARIABLES (.env.example)
# ============================================================================

# 1. Gemini API Key (Untuk Fitur AI UGC Affiliate + Video Reference Analysis)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# 2. Kredensial Admin Server-Side (Wajib diset di Vercel Environment Variables / .env)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change_me_strong_password"
ADMIN_SESSION_SECRET="change_me_random_hmac_session_secret_2026"

# 3. Konfigurasi Firebase / Firestore Persistent Storage Server-Side (Vercel Production)
# Gunakan nilai dari firebase-applet-config.json atau Firebase Console Project Settings
FIREBASE_PROJECT_ID="gen-lang-client-0407129505"
FIREBASE_DATABASE_ID="ai-studio-6155f990-3034-42f5-aa1b-325341d85b3e"
FIREBASE_API_KEY="YOUR_FIREBASE_WEB_API_KEY"
FIREBASE_APP_ID="YOUR_FIREBASE_WEB_APP_ID"

# Opsional: Service Account Credentials jika menggunakan Firebase Admin SDK di Vercel
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_SERVICE_ACCOUNT_JSON=""

# 4. Konfigurasi Mission Install APK & Verifikasi Telegram Bot API
COINOVA_APK_DOWNLOAD_URL="https://coinova.app/download/coinova-latest.apk"
VITE_APK_DOWNLOAD_URL="https://coinova.app/download/coinova-latest.apk"
APK_VERIFY_SECRET="change_me_apk_install_callback_secret"
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"
TELEGRAM_CHANNEL_ID="@CoinovaOfficiall"
TELEGRAM_CHANNEL_URL="https://t.me/CoinovaOfficiall"


